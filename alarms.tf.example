
# T11 - CloudWatch alarms for Life Sciences

locals {
  cloudwatch_alarms = {
    ec2_cpu = {
      metric     = "CPUUtilization"
      namespace  = "AWS/EC2"
      statistic  = "Average"
      threshold  = 80
      comparison = "GreaterThanThreshold"
      dimensions = {
        AutoScalingGroupName = aws_autoscaling_group.web.name
      }
    }

    alb_unhealthy_hosts = {
      metric     = "UnHealthyHostCount"
      namespace  = "AWS/ApplicationELB"
      statistic  = "Maximum"
      threshold  = 1
      comparison = "GreaterThanOrEqualToThreshold"
      dimensions = {
        LoadBalancer = aws_lb.web.arn_suffix
        TargetGroup  = aws_lb_target_group.web.arn_suffix
      }
    }

    alb_5xx_errors = {
      metric     = "HTTPCode_ELB_5XX_Count"
      namespace  = "AWS/ApplicationELB"
      statistic  = "Sum"
      threshold  = 5
      comparison = "GreaterThanOrEqualToThreshold"
      dimensions = {
        LoadBalancer = aws_lb.web.arn_suffix
      }
    }

    rds_cpu = {
      metric     = "CPUUtilization"
      namespace  = "AWS/RDS"
      statistic  = "Average"
      threshold  = 80
      comparison = "GreaterThanThreshold"
      dimensions = {
        DBInstanceIdentifier = aws_db_instance.postgres.identifier
      }
    }

    rds_low_storage = {
      metric     = "FreeStorageSpace"
      namespace  = "AWS/RDS"
      statistic  = "Average"
      threshold  = 2147483648
      comparison = "LessThanThreshold"
      dimensions = {
        DBInstanceIdentifier = aws_db_instance.postgres.identifier
      }
    }
  }
}

resource "aws_cloudwatch_metric_alarm" "infrastructure" {
  for_each = local.cloudwatch_alarms

  alarm_name          = "LifeSciences-${each.key}"
  alarm_description   = "Life Sciences infrastructure monitoring"
  namespace           = each.value.namespace
  metric_name         = each.value.metric
  statistic           = each.value.statistic
  period              = 300
  evaluation_periods  = 2
  threshold           = each.value.threshold
  comparison_operator = each.value.comparison
  dimensions          = each.value.dimensions
  treat_missing_data  = "notBreaching"

  actions_enabled = false

  tags = {
    Name = "LifeSciences-${each.key}"
  }
}

# EC2 status check alarms need actual instance IDs.
# We will populate these after redeployment.
variable "status_check_instance_ids" {
  type    = set(string)
  default = []
}

resource "aws_cloudwatch_metric_alarm" "ec2_status_check" {
  for_each = var.status_check_instance_ids

  alarm_name          = "LifeSciences-EC2-Status-${each.value}"
  alarm_description   = "EC2 instance failed a status check"
  namespace           = "AWS/EC2"
  metric_name         = "StatusCheckFailed"
  statistic           = "Maximum"
  period              = 300
  evaluation_periods  = 2
  threshold           = 1
  comparison_operator = "GreaterThanOrEqualToThreshold"

  dimensions = {
    InstanceId = each.value
  }

  treat_missing_data = "missing"
  actions_enabled    = false

  tags = {
    Name = "LifeSciences-EC2-Status-Check"
  }
}
